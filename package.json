{
  "name": "schoolweb",
  "version": "1.0.0",
  "description": "Website statis Sekolah Terpadu Sedaya Bintang",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build:css": "tailwindcss -c tailwind.config.cjs -i tools/tailwind.css -o public/css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.cjs -i tools/tailwind.css -o public/css/tailwind.css --watch",
    "build": "npm run build:css"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "private": true,
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  },
  "engines": {
    "node": ">=18"
  }
}
